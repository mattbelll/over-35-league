---
interface Props {
  eyebrow?: string;
  title: string;
  align?: "left" | "center";
  class?: string;
}
const { eyebrow, title, align = "left", class: className = "" } = Astro.props;
const alignment = align === "center" ? "text-center items-center" : "text-left items-start";
---

<div class={`flex flex-col gap-2 ${alignment} ${className}`}>
  {eyebrow && (
    <span class="flex items-center gap-2 text-sm font-bold uppercase tracking-[0.2em] text-ice-700">
      <span class="h-px w-6 bg-flare-500" aria-hidden="true"></span>
      {eyebrow}
    </span>
  )}
  <h2 class="text-3xl sm:text-4xl lg:text-5xl leading-[0.95]">{title}</h2>
</div>
