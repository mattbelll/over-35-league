---
import { site, nav } from "@/data/site";
const year = new Date().getFullYear();
---

<footer class="border-t border-rink-200 bg-rink-50">
  <div class="container-page grid gap-10 py-14 md:grid-cols-3">
    <div>
      <img src="/images/logo.png" alt={site.name} width="1080" height="560" class="h-12 w-auto" />
      <p class="mt-4 max-w-xs text-sm text-rink-600">A recreational hockey league in Charleston, SC for players 35 and up. Register to join a future season.</p>
    </div>

    <div>
      <h3 class="text-sm tracking-widest text-ice-700">Explore</h3>
      <ul class="mt-4 space-y-2 text-sm">
        {nav.map((item) => (
          <li><a href={item.href} class="text-rink-600 hover:text-rink-950">{item.label}</a></li>
        ))}
        <li><a href="/registration" class="text-rink-600 hover:text-rink-950">Registration</a></li>
      </ul>
    </div>

    <div>
      <h3 class="text-sm tracking-widest text-ice-700">Contact</h3>
      <address class="mt-4 text-sm not-italic text-rink-600">
        <p class="font-semibold text-rink-950">Carolina Ice Palace</p>
        <p>7665 Northwoods Blvd</p>
        <p>North Charleston, SC 29406</p>
      </address>
      <div class="mt-4 flex gap-3">
        <a href={site.social.instagram} class="text-rink-400 hover:text-ice-600" aria-label="Instagram" rel="noopener noreferrer" target="_blank">
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.8.3 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.1.4.3 1 .4 2.2.1 1.2.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.3 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.1-1 .3-2.2.4-1.2.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.8-.3-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.1-.4-.3-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8c.1-1.2.3-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.1 1-.3 2.2-.4C8.4 2.2 8.8 2.2 12 2.2Zm0 1.8c-3.1 0-3.5 0-4.7.1-1.1.1-1.7.2-2.1.4-.5.2-.9.4-1.3.8-.4.4-.6.8-.8 1.3-.2.4-.3 1-.4 2.1-.1 1.2-.1 1.6-.1 4.7s0 3.5.1 4.7c.1 1.1.2 1.7.4 2.1.2.5.4.9.8 1.3.4.4.8.6 1.3.8.4.2 1 .3 2.1.4 1.2.1 1.6.1 4.7.1s3.5 0 4.7-.1c1.1-.1 1.7-.2 2.1-.4.5-.2.9-.4 1.3-.8.4-.4.6-.8.8-1.3.2-.4.3-1 .4-2.1.1-1.2.1-1.6.1-4.7s0-3.5-.1-4.7c-.1-1.1-.2-1.7-.4-2.1-.2-.5-.4-.9-.8-1.3-.4-.4-.8-.6-1.3-.8-.4-.2-1-.3-2.1-.4-1.2-.1-1.6-.1-4.7-.1Zm0 3.1a4.9 4.9 0 1 1 0 9.8 4.9 4.9 0 0 1 0-9.8Zm0 8a3.1 3.1 0 1 0 0-6.2 3.1 3.1 0 0 0 0 6.2Zm6.3-8.2a1.1 1.1 0 1 1-2.3 0 1.1 1.1 0 0 1 2.3 0Z"/></svg>
        </a>
      </div>
    </div>
  </div>

  <div class="border-t border-rink-200">
    <div class="container-page flex flex-col items-center justify-between gap-2 py-6 text-xs text-rink-500 sm:flex-row">
      <p>© {year} {site.name}. Team, schedule and standings data from the league's official sheets.</p>
      <p>Built with Astro + Tailwind CSS.</p>
    </div>
  </div>
</footer>
