---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GameCard from "@/components/GameCard.astro";
import Button from "@/components/Button.astro";
import teams from "@/data/teams.json";
import { gamesForTeam, sortedStandings } from "@/lib/hockey";

export function getStaticPaths() {
  return teams.map((team) => ({ params: { slug: team.slug }, props: { team } }));
}

const { team } = Astro.props;
const games = gamesForTeam(team.slug);
const upcoming = games.filter((g) => g.status === "scheduled").slice(0, 4);
const results = games.filter((g) => g.status === "final").reverse().slice(0, 4);

const standing = sortedStandings();
const record = standing.find((r) => r.slug === team.slug);
---

<BaseLayout
  title={team.name}
  description={`${team.name} — ${team.tagline} Record and schedule in the Over 35 League.`}
>
  <!-- Team header with brand color -->
  <section class="relative overflow-hidden border-b border-rink-200" style={`background:linear-gradient(135deg, ${team.primaryColor}1f, #ffffff)`}>
    <div class="container-page relative py-12 sm:py-16">
      <a href="/teams" class="text-sm font-semibold text-ice-700 hover:text-ice-800">← All teams</a>
      <div class="mt-4 flex flex-wrap items-center gap-6">
        <img
          src={team.image}
          alt={`${team.name} team photo`}
          class="h-28 w-28 shrink-0 rounded-2xl border border-rink-200 object-cover shadow-sm sm:h-32 sm:w-32"
        />
        <div>
          <p class="text-sm font-bold uppercase tracking-widest text-ice-700">Over 35 League</p>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl">{team.name}</h1>
        </div>
      </div>
    </div>
  </section>

  <section class="container-page grid gap-10 py-14 lg:grid-cols-[1fr_1.6fr]">
    <!-- Sidebar: record + about -->
    <aside class="space-y-6">
      {record && (
        <div class="rounded-xl border border-rink-200 bg-white p-6 shadow-sm">
          <h2 class="text-xl">Season record</h2>
          <div class="mt-4 flex items-baseline gap-3">
            <span class="font-display text-4xl font-extrabold text-rink-950">{record.w}-{record.l}-{record.otl}{record.t ? `-${record.t}` : ""}</span>
            <span class="text-sm text-rink-500">W-L-OTL{record.t ? "-T" : ""}</span>
          </div>
          <dl class="mt-5 space-y-3 text-sm">
            <div class="flex justify-between border-b border-rink-200 pb-3"><dt class="text-rink-500">Standing</dt><dd class="font-semibold text-rink-950">#{record.rank} of {standing.length}</dd></div>
            <div class="flex justify-between border-b border-rink-200 pb-3"><dt class="text-rink-500">Points</dt><dd class="font-semibold text-rink-950">{record.pts}</dd></div>
            <div class="flex justify-between border-b border-rink-200 pb-3"><dt class="text-rink-500">Games played</dt><dd class="font-semibold text-rink-950">{record.gp}</dd></div>
            <div class="flex justify-between border-b border-rink-200 pb-3"><dt class="text-rink-500">Goals for / against</dt><dd class="font-semibold text-rink-950">{record.gf} / {record.ga}</dd></div>
            <div class="flex justify-between"><dt class="text-rink-500">Goal differential</dt><dd class={`font-semibold ${record.diff > 0 ? "text-ice-700" : record.diff < 0 ? "text-flare-600" : "text-rink-950"}`}>{record.diff > 0 ? `+${record.diff}` : record.diff}</dd></div>
          </dl>
        </div>
      )}
      <div class="rounded-xl border border-rink-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl">About</h2>
        <p class="mt-3 text-sm text-rink-600">{team.description}</p>
      </div>
    </aside>

    <!-- Main: roster placeholder + games -->
    <div class="space-y-10">
      <div>
        <h2 class="text-2xl">Current Roster</h2>
        {team.roster.length > 0 ? (
          <div class="mt-5 overflow-x-auto rounded-xl border border-rink-200 bg-white shadow-sm">
            <table class="w-full min-w-[18rem] text-left text-sm">
              <thead>
                <tr class="border-b border-rink-200 text-xs uppercase tracking-wider text-rink-500">
                  <th scope="col" class="px-4 py-3 font-semibold">Player</th>
                  <th scope="col" class="px-4 py-3 text-center font-semibold">Pos</th>
                </tr>
              </thead>
              <tbody>
                {team.roster.map((player) => (
                  <tr class="border-b border-rink-100 last:border-0 hover:bg-rink-50">
                    <th scope="row" class="px-4 py-3 font-semibold text-rink-950">{player.name}</th>
                    <td class="px-4 py-3 text-center">
                      <span class={`inline-block min-w-7 rounded px-1.5 py-0.5 text-xs font-bold ${
                        player.pos === "G" ? "bg-flare-500/15 text-flare-700"
                        : player.pos === "D" ? "bg-ice-500/15 text-ice-800"
                        : "bg-rink-100 text-rink-700"
                      }`}>{player.pos}</span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <div class="mt-5 rounded-xl border border-dashed border-rink-300 bg-rink-50 p-6 text-sm text-rink-600">
            Roster to be announced.
          </div>
        )}
        <p class="mt-3 text-xs text-rink-500">Position: F (forward), D (defense), G (goalie).</p>
      </div>

      {upcoming.length > 0 && (
        <div>
          <h2 class="text-2xl">Upcoming games</h2>
          <div class="mt-5 grid gap-4 sm:grid-cols-2">
            {upcoming.map((game) => <GameCard game={game} />)}
          </div>
        </div>
      )}

      {results.length > 0 && (
        <div>
          <h2 class="text-2xl">Recent results</h2>
          <div class="mt-5 grid gap-4 sm:grid-cols-2">
            {results.map((game) => <GameCard game={game} />)}
          </div>
        </div>
      )}

      <div class="pt-2">
        <Button href="/schedule" variant="ghost">View full league schedule</Button>
      </div>
    </div>
  </section>
</BaseLayout>
