---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import TeamCard from "@/components/TeamCard.astro";
import { allTeams } from "@/lib/hockey";

const teams = allTeams;
---

<BaseLayout
  title="Teams"
  description="Meet the eight teams of the Over 35 League at Carolina Ice Palace."
>
  <PageHeader
    eyebrow="The teams"
    title="Teams"
    description="Eight teams battling it out at Carolina Ice Palace. Click any team to see its record and schedule."
  />

  <section class="container-page py-16 sm:py-20">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {teams.map((team) => <TeamCard team={team} />)}
    </div>
  </section>
</BaseLayout>
