---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import TeamCard from "@/components/TeamCard.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import StandingsTable from "@/components/StandingsTable.astro";
import PlayoffBracket from "@/components/PlayoffBracket.astro";
import Button from "@/components/Button.astro";
import { allTeams } from "@/lib/hockey";

const teams = allTeams;
---

<BaseLayout
  title="Teams"
  description="Meet the eight teams of the Over 35 League at Carolina Ice Palace."
>
  <PageHeader
    eyebrow="The teams"
    title="Teams"
    description="Eight teams battling it out at Carolina Ice Palace. Click any team to see its record and schedule."
  />

  <section class="container-page py-16 sm:py-20">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {teams.map((team) => <TeamCard team={team} />)}
    </div>
  </section>

  <!-- Playoff bracket -->
  <section class="border-t border-rink-200">
    <div class="container-page py-16 sm:py-20">
      <SectionHeading eyebrow="Postseason" title="Summer 2026 Playoff Bracket" />
      <p class="mt-3 max-w-2xl text-sm text-rink-600">Top two seeds earn first-round byes into the semifinals. Winners advance until one team is crowned Summer 2026 champion.</p>
      <div class="mt-8">
        <PlayoffBracket />
      </div>
    </div>
  </section>

  <!-- Current standings -->
  <section class="border-t border-rink-200 bg-rink-50">
    <div class="container-page py-16 sm:py-20">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <SectionHeading eyebrow="Where things stand" title="Current standings" />
        <Button href="/schedule#standings" variant="ghost">Results &amp; schedule</Button>
      </div>
      <div class="mt-8">
        <StandingsTable />
      </div>
    </div>
  </section>
</BaseLayout>
