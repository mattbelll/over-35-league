---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import BlogCard from "@/components/BlogCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
---

<BaseLayout
  title="Blog"
  description="News, recaps and guides from the Over 35 League office."
>
  <PageHeader
    eyebrow="From the league office"
    title="News & notes"
    description="Season recaps, registration updates, gear guides and everything happening around the rink."
  />

  <section class="container-page py-16 sm:py-20">
    {posts.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <BlogCard
            href={`/blog/${post.id}`}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            author={post.data.author}
            tags={post.data.tags}
            heroImage={post.data.heroImage}
          />
        ))}
      </div>
    ) : (
      <p class="rounded-xl border border-rink-200 bg-white p-6 text-rink-600 shadow-sm">No posts yet — check back soon.</p>
    )}
  </section>
</BaseLayout>
