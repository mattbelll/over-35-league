---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import { site } from "@/data/site";

// Update this whenever the policy changes.
const lastUpdated = "August 8, 2026";
---

<BaseLayout
  title="Privacy Policy"
  description="How the Over 35 League collects, uses, and protects the information you share through our waitlist and contact forms."
>
  <PageHeader
    eyebrow="Legal"
    title="Privacy Policy"
    description={`How we handle the information you share with the Over 35 League. Last updated ${lastUpdated}.`}
  />

  <section class="container-page py-16 sm:py-20">
    <div class="mx-auto max-w-3xl space-y-10 text-rink-700 [&_a]:font-semibold [&_a]:text-ice-700 [&_a:hover]:text-ice-800 [&_h2]:mb-3 [&_h2]:text-2xl [&_li]:mt-1.5 [&_p]:mt-3 [&_ul]:mt-3 [&_ul]:list-disc [&_ul]:pl-6">
      <p>
        This Privacy Policy explains what information the Over 35 League ("the League," "we," "us") collects, how we use it,
        and the choices you have. It applies to <a href={site.url}>{site.url.replace("https://", "")}</a> and the forms on it.
        The League is a recreational adult hockey league based at the Carolina Ice Palace in North Charleston, South Carolina.
      </p>

      <div>
        <h2>Information we collect</h2>
        <p>We only collect information that you choose to give us. That happens in two places:</p>
        <ul>
          <li>
            <strong>Waitlist / registration form.</strong> Our registration page embeds a Google Form. When you submit it,
            you may provide details such as your name, contact information, and hockey background (for example, the position
            you play and your prior playing experience).
          </li>
          <li>
            <strong>Contact form.</strong> When you message us through our <a href="/contact">Contact page</a>, we collect
            your name, email address, subject, and message.
          </li>
        </ul>
        <p>
          We do not use analytics or advertising trackers on this site, and we do not knowingly collect any information
          beyond what you submit through these forms.
        </p>
      </div>

      <div>
        <h2>How we use your information</h2>
        <ul>
          <li>To add you to the waitlist and contact you when a roster spot opens up.</li>
          <li>To respond to your questions and communicate with you about the League.</li>
          <li>To organize teams, schedules, and league operations.</li>
        </ul>
      </div>

      <div>
        <h2>How your information is stored</h2>
        <p>
          We rely on two third-party services to receive and store form submissions. Your information is handled under
          their privacy and security practices:
        </p>
        <ul>
          <li>
            <strong>Google (Google Forms)</strong> processes waitlist/registration submissions. See the
            <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">Google Privacy Policy</a>.
          </li>
          <li>
            <strong>Netlify</strong> hosts this website and processes contact-form submissions. See the
            <a href="https://www.netlify.com/privacy/" target="_blank" rel="noopener noreferrer">Netlify Privacy Policy</a>.
          </li>
        </ul>
      </div>

      <div>
        <h2>Cookies</h2>
        <p>
          Our own site does not set tracking cookies. However, the embedded Google Form on the registration page may set
          cookies controlled by Google as part of loading and submitting the form. You can manage cookies through your
          browser settings.
        </p>
      </div>

      <div>
        <h2>Sharing your information</h2>
        <p>
          We do not sell, rent, or trade your personal information. We share it only with the service providers listed
          above so we can operate the League's forms, or where we are required to do so by law.
        </p>
      </div>

      <div>
        <h2>How long we keep it</h2>
        <p>
          We keep waitlist and contact information only as long as it is needed to run the League and respond to you. You
          can ask us to delete your information at any time (see below).
        </p>
      </div>

      <div>
        <h2>Your choices</h2>
        <p>
          You can request a copy of the information you've submitted, ask us to correct it, or ask us to delete it. To make
          a request, message us through our <a href="/contact">Contact page</a> and we'll take care of it.
        </p>
      </div>

      <div>
        <h2>Children's privacy</h2>
        <p>
          The Over 35 League is intended for adults aged 35 and over. This site is not directed to children, and we do not
          knowingly collect information from anyone under 18.
        </p>
      </div>

      <div>
        <h2>Changes to this policy</h2>
        <p>
          We may update this policy from time to time. When we do, we'll revise the "Last updated" date at the top of this
          page. Significant changes will be reflected here.
        </p>
      </div>

      <div>
        <h2>Contact us</h2>
        <p>
          Questions about this policy or your information? Reach out through our <a href="/contact">Contact page</a> and
          we'll get back to you.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
