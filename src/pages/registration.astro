---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import Button from "@/components/Button.astro";
import { site } from "@/data/site";
---

<BaseLayout
  title="Registration"
  description="The Over 35 League is currently full. Submit the form to join the waitlist and we'll reach out as roster spots open up."
>
  <PageHeader
    eyebrow="Join the League"
    title="Registration"
    description="The league is currently full. We accept registrations to join the waitlist on a rolling basis. As roster availability opens up, we will contact you to formally join the league. Submit the form below to join the waitlist. Thank you for your interest in the league!"
  />

  <!-- Embedded form slot -->
  <section id="register-form" class="container-page scroll-mt-20 py-16 sm:py-20">
    <SectionHeading eyebrow="Sign up" title="Join the waitlist" align="center" class="mx-auto max-w-2xl" />
    <div class="mx-auto mt-8 max-w-3xl">
      {site.registrationEmbedUrl ? (
        <div class="overflow-hidden rounded-2xl border border-rink-200 bg-white shadow-sm">
          <iframe
            src={site.registrationEmbedUrl}
            title="League waitlist form"
            loading="lazy"
            class="h-[1669px] w-full"
          ></iframe>
        </div>
      ) : (
        <div class="rounded-2xl border border-dashed border-ice-500/50 bg-rink-50 p-8 text-center">
          <h3 class="text-2xl text-rink-950">Form embed goes here</h3>
          <p class="mx-auto mt-3 max-w-xl text-rink-600">
            This page is wired up for a <strong class="text-rink-900">Tally</strong> or <strong class="text-rink-900">Google Forms</strong> embed. Paste your form's
            share URL into <code class="rounded bg-rink-100 px-1.5 py-0.5 text-ice-700">registrationEmbedUrl</code> in
            <code class="rounded bg-rink-100 px-1.5 py-0.5 text-ice-700">src/data/site.ts</code> and the live form will
            replace this placeholder automatically.
          </p>
          <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <Button href="https://tally.so" variant="secondary">Create a Tally form</Button>
            <Button href="https://forms.google.com" variant="ghost">Use Google Forms</Button>
          </div>
          <p class="mt-6 text-sm text-rink-500">Questions about the waitlist? Email <a href={`mailto:${site.email}`} class="font-semibold text-ice-700 hover:text-ice-800">{site.email}</a>.</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
