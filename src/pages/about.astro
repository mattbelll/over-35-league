---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import CTASection from "@/components/CTASection.astro";

const values = [
  { title: "Respect the game", body: "Play hard, play clean. Referees' calls are final and handshakes are mandatory." },
  { title: "Everyone plays", body: "Balanced rosters and fair ice time. This is rec hockey — everyone gets their shifts." },
  { title: "Safety first", body: "Full equipment required, certified officials, and a zero-tolerance policy for reckless play." },
  { title: "Have Fun", body: "The scoreboard resets every week. The friendships last. Buy your buddies a bucket before last call." },
];

const faqs = [
  { q: "Who can play in the Over 35 League?", a: "Any adult hockey player aged 35 and over. Skill levels range from returning rec players to former competitive players and retired professionals. The league keeps rosters balanced so games stay fun and competitive." },
  { q: "How does the draft work?", a: "All registered players are assigned a skill rating and entered into the draft pool. Captains select a draft position at random, and draft their team each season. Every season each team is different. This makes for balanced skill levels on all teams." },
  { q: "Can I register without a team?", a: "Yes. That's the only way to do it, as captains are already assigned. Sign up as an individual player and you will be drafted to a team before the start of the season." },
  { q: "What equipment do I need?", a: "Full protective gear is required: helmet with cage or shield, skates, gloves, elbows, shin guards, and pants are required. Shoulder pads are optional." },
  { q: "When and where are games played?", a: "Games are played every Thursday night at the Carolina Ice Palace in North Charleston, SC across two sheets of ice, the Palace and Royal rinks. Game times are published before the start of every season, and typically begin after 7:30PM." },
  { q: "How does the season work?", a: "Each team plays a full regular season schedule of 12-14 games followed by a single-elimination playoff bracket seeded by the final standings. The top six out of eight teams at the end of the regular season make the playoffs." },
];

// "League at a glance" — laid out as a horizontal icon row (see below).
const glance = [
  { label: "Founded", value: "2006", icon: "M8 7V3m8 4V3M3 11h18M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" },
  { label: "Founder", value: "Andrew Miller", icon: "M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" },
  { label: "Location", value: "Charleston, SC", icon: "M12 21s-7-6.2-7-11a7 7 0 1114 0c0 4.8-7 11-7 11z M12 10a2 2 0 100-4 2 2 0 000 4z" },
  { label: "Home rink", value: "Carolina Ice Palace", icon: "M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6" },
  { label: "Game night", value: "Thursdays", icon: "M12 8v4l3 2m6-2a9 9 0 11-18 0 9 9 0 0118 0z" },
  { label: "Teams", value: "8", icon: "M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1.13a4 4 0 10-4 0m8 0a4 4 0 10-4 0" },
  { label: "Age group", value: "35 and up", icon: "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" },
];
---

<BaseLayout
  title="About"
  description="About the Over 35 Hockey League — founded in 2006 by Andrew Miller at Carolina Ice Palace in Charleston, South Carolina."
>
  <PageHeader
    eyebrow="About the league"
    title="About the Over 35 Hockey League"
    description="A competitive, welcoming hockey community for players over 35 — founded in 2006 in Charleston, South Carolina."
  />

  <!-- Our Story -->
  <section class="container-page py-16 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.5fr_1fr]">
      <div class="space-y-5 text-rink-700">
        <SectionHeading eyebrow="Our Story" title="Where it started" />
        <p>
          Founded in 2006 by Andrew Miller, the Over 35 Hockey League at the Carolina Ice Palace in Charleston, South
          Carolina, was built with a simple vision: create a competitive, welcoming hockey community where players over the
          age of 35 could continue playing the game they love in the right spirit.
        </p>
        <p>
          A longtime sports journalist, recreational hockey player, sports fan, and passionate community builder, Andrew
          recognized that many adult hockey leagues had earned a reputation for becoming overly physical, chippy, and driven
          by ego. He believed there was a better way.
        </p>
        <p>
          From the beginning, the Over 35 Hockey League was founded on the principles of sportsmanship, fair play,
          friendship, and respect. While every game is played with intensity and a desire to win, the league has always
          prioritized character over conflict. Opponents battle hard for three periods, shake hands at the final buzzer, and
          then share a beer together afterward.
        </p>
        <p class="text-rink-950 font-semibold">
          What truly sets the league apart, however, happens away from the rink.
        </p>
      </div>

      <!-- Founder portrait -->
      <figure class="h-fit overflow-hidden rounded-2xl border border-rink-200 bg-white shadow-sm">
        <img
          src="/images/andrew-miller.jpg"
          alt="Andrew Miller, founder of the Over 35 League"
          width="720"
          height="720"
          class="aspect-square w-full object-cover"
        />
        <figcaption class="flex items-center justify-between gap-3 p-5">
          <div>
            <p class="font-display text-xl font-bold text-rink-950">Andrew Miller</p>
            <p class="text-xs font-bold uppercase tracking-widest text-ice-700">Founder</p>
          </div>
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-flare-500 font-display text-lg font-extrabold text-white">'06</span>
        </figcaption>
      </figure>
    </div>

    <!-- League at a glance — horizontal icon row -->
    <div class="mt-14 border-t border-rink-200 pt-10">
      <h3 class="flex items-center gap-2 text-sm font-bold uppercase tracking-[0.2em] text-ice-700">
        <span class="h-px w-6 bg-flare-500" aria-hidden="true"></span>League at a glance
      </h3>
      <dl class="mt-7 grid grid-cols-2 gap-x-6 gap-y-9 sm:grid-cols-4 lg:grid-cols-7">
        {glance.map((stat) => (
          <div class="flex flex-col items-center gap-2.5 text-center">
            <span class="grid h-11 w-11 place-items-center rounded-xl bg-ice-500/10 text-ice-700">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={stat.icon} /></svg>
            </span>
            <dt class="text-xs uppercase tracking-wider text-rink-500">{stat.label}</dt>
            <dd class="font-display text-lg font-bold leading-tight text-rink-950">{stat.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Community Culture -->
  <section class="border-y border-rink-200 bg-rink-50">
    <div class="container-page py-16 sm:py-20">
      <SectionHeading eyebrow="Community Culture" title="Bigger than hockey" />
      <div class="mt-8 grid gap-8 lg:grid-cols-2 lg:gap-12">
        <div class="space-y-5 text-rink-700">
          <p>
            The community Andrew envisioned extends far beyond Thursday nights at the Carolina Ice Palace. When one of our
            own is facing hardship, the league rallies together. Whether organizing charity games, supporting GoFundMe
            campaigns, raising money for families in need, or simply showing up for a teammate during life's toughest
            moments, our players consistently demonstrate that being part of this league means being part of something
            bigger than hockey.
          </p>
          <p>
            The Over 35 Hockey League is more than a place to play. It is a community built on friendship, respect, and
            shared experiences. It is a league where fierce competitors become lifelong friends, where teammates become
            family, and where everyone who steps onto the ice understands that the bonds formed here matter just as much
            as the final score.
          </p>
        </div>
        <figure class="flex h-fit flex-col justify-center rounded-2xl border-l-4 border-flare-500 bg-white p-8 shadow-sm">
          <blockquote class="font-display text-2xl font-bold leading-tight text-rink-950 sm:text-3xl">
            For us, hockey is the game that brings us together. The community is what keeps us coming back.
          </blockquote>
        </figure>
      </div>
    </div>
  </section>

  <!-- Our Code -->
  <section class="container-page py-16 sm:py-20">
    <SectionHeading eyebrow="What we value" title="Our code" />
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {values.map((v) => (
        <div class="rounded-xl border border-rink-200 bg-white p-6 shadow-sm">
          <h3 class="text-lg">{v.title}</h3>
          <p class="mt-2 text-sm text-rink-600">{v.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-rink-200 bg-rink-50">
    <div class="container-page py-16 sm:py-20">
      <SectionHeading eyebrow="Good to know" title="Frequently asked questions" />
      <div class="mt-8 divide-y divide-rink-200 rounded-xl border border-rink-200 bg-white shadow-sm">
        {faqs.map((faq) => (
          <details class="group px-6">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-left font-display text-lg font-bold text-rink-950 [&::-webkit-details-marker]:hidden">
              {faq.q}
              <svg class="h-5 w-5 shrink-0 text-ice-700 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
            </summary>
            <p class="pb-5 text-rink-600">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
